# Shadow Agent compose environment — copy to .env and fill in real secrets.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Required secrets (startup fails without them) ---
# JWT signing key for console sessions (min 32 chars). Never reuse across environments.
SHADOW_AGENT_JWT_SECRET=replace-with-random-32-plus-characters
# Static gateway API keys (machine-to-machine auth for client/admin callers).
SHADOW_AGENT_ADMIN_API_KEY=replace-with-random-admin-key
SHADOW_AGENT_CLIENT_API_KEY=replace-with-random-client-key
# Pepper for hashing managed API keys at rest.
SHADOW_AGENT_API_KEY_PEPPER=replace-with-random-pepper

# --- Console bootstrap ---
# Long random token required by the FIRST console admin registration.
SHADOW_AGENT_CONSOLE_BOOTSTRAP_TOKEN=replace-with-long-random-bootstrap-token
SHADOW_AGENT_ALLOW_OPEN_CONSOLE_BOOTSTRAP=false

# --- Networking ---
# Host ports published by docker compose.
SHADOW_AGENT_BACKEND_PORT=8000
SHADOW_AGENT_FRONTEND_PORT=3000
# CORS origins allowed to call the backend API.
SHADOW_AGENT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# URL the browser uses to reach the backend (baked into the frontend at build).
SHADOW_AGENT_PUBLIC_API_BASE=http://localhost:8000

# --- Upstream LLM provider ---
SHADOW_AGENT_UPSTREAM_BASE_URL=https://api.example.com
SHADOW_AGENT_UPSTREAM_API_KEY=replace-with-upstream-provider-key
SHADOW_AGENT_UPSTREAM_MODEL=replace-with-upstream-model-name
# Simulated responses are for local demos only — keep false in production.
SHADOW_AGENT_ALLOW_SIMULATED_RESPONSES=false

# --- High availability (optional, multi-instance only) ---
# Share the rate limiter and login lockout across replicas. Requires the redis
# package (requirements-redis.txt) and build arg INSTALL_REDIS=true when using
# docker compose. Leave empty for single-instance deployments.
SHADOW_AGENT_REDIS_URL=
SHADOW_AGENT_ENABLE_REDIS=false

# --- Automatic log retention (GDPR data minimization) ---
# Expired rows are purged at startup and then periodically. Defaults: intercept
# logs / alerts / replay runs 180 days, audit logs 365 days. Set a per-table
# value to 0 to keep that table forever.
SHADOW_AGENT_LOG_RETENTION_DAYS=180
SHADOW_AGENT_INTERCEPT_LOG_RETENTION_DAYS=180
SHADOW_AGENT_AUDIT_LOG_RETENTION_DAYS=365
SHADOW_AGENT_ALERT_RETENTION_DAYS=180
SHADOW_AGENT_REPLAY_RETENTION_DAYS=180
SHADOW_AGENT_RETENTION_CLEANUP_INTERVAL_SECONDS=3600
